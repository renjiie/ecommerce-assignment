VITE_API_BASE_URL=http://localhost:8000

# Reviewer/dev mode. Sends X-Dev-Role and X-Dev-User-Id to the FastAPI dev bypass.
# Ignored by production builds; production always uses Clerk auth.
VITE_AUTH_BYPASS=true

# Clerk mode. Required when VITE_AUTH_BYPASS=false.
VITE_CLERK_PUBLISHABLE_KEY=

# Shows the in-app reviewer role switch after Clerk sign-in in local/test mode.
VITE_REVIEWER_ROLE_SWITCH=true
