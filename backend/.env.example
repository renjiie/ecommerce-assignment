ENV=development
DEBUG=false
AUTH_BYPASS=true
DEV_AUTH_USER_ID=dev-user
DEV_AUTH_EMAIL=dev@local.dev
DEV_AUTH_ROLE=CUSTOMER
# Frontend dev mode can override these per request with:
# X-Dev-Role, X-Dev-User-Id, X-Dev-Email.
# Clerk sign-in mode can also switch reviewer roles in development with:
# X-Reviewer-Role, X-Reviewer-User-Id.
REVIEWER_ROLE_SWITCH_ENABLED=true

DATABASE_URL=postgresql+asyncpg://orders:orders@localhost:5432/orders
REDIS_URL=redis://localhost:6379/0

# Clerk mode needs one backend verification key. Prefer CLERK_JWT_KEY for
# networkless verification, or set CLERK_SECRET_KEY to let Clerk's SDK fetch JWKS.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=[]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174"]
